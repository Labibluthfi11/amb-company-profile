---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import MarqueeBanner from '../components/MarqueeBanner.astro';
import About from '../components/About.astro';
import Certificate from '../components/Certificate.astro';
import Partners from '../components/Partners.astro';
import Services from '../components/Services.astro';
import Innovation from '../components/Innovation.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import ServicesHero from '../components/ServicesHero.astro';
import Testimonials from '../components/Testimonials.astro';
import LocationMap from '../components/LocationMap.astro';
import SocialMedia from '../components/SocialMedia.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <MarqueeBanner />
    <About />
    <Certificate />
    <Partners />
    <Services />
    <ProcessFlow />
    <ServicesHero />
    <Innovation />
