<section class="w-full py-20 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 flex flex-col items-center gap-12">
    
    <!-- Title Section -->
    <div class="max-w-3xl text-center space-y-4">
      <h2 class="text-3xl md:text-4xl font-extrabold text-black uppercase tracking-wide">
        PRODUK YANG TELAH KAMI BUAT
      </h2>
      <p class="text-lg md:text-xl text-black font-semibold leading-relaxed">
        di bawah ini adalah produk brand-brand yang telah mempercayakan produknya kepada PT Ansel Muda Berkarya
      </p>
    </div>

    <!-- Carousel Container -->
    <div class="relative w-full max-w-5xl h-[420px] md:h-[620px] flex items-center justify-center select-none overflow-visible px-4">
      
      <!-- Left Navigation Button -->
      <button 
        id="prev-btn" 
        class="absolute left-0 md:left-4 lg:-left-12 z-30 w-12 h-12 md:w-14 md:h-14 flex items-center justify-center bg-[#0066FF] hover:bg-blue-600 active:scale-95 text-white rounded-full transition-all duration-300 shadow-md cursor-pointer hover:shadow-lg focus:outline-none"
        aria-label="Previous Product"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      <!-- 3D Track -->
      <div class="carousel-track relative w-full h-full flex items-center justify-center [perspective:1200px] overflow-visible">
        
        <!-- Slide 1 (Left initially) -->
        <div class="carousel-item absolute w-[240px] h-[300px] md:w-[456px] md:h-[570px] cursor-pointer origin-center" data-index="0">
          <img 
            src="/parfume.svg" 
            alt="Parfum Balm" 
            class="w-full h-full object-cover rounded-[40px] shadow-lg pointer-events-none"
          />
        </div>

        <!-- Slide 2 (Center initially) -->
        <div class="carousel-item absolute w-[240px] h-[300px] md:w-[456px] md:h-[570px] cursor-pointer origin-center" data-index="1">
          <img 
            src="/will.svg" 
            alt="Parfum Gel 2-In-1" 
            class="w-full h-full object-cover rounded-[40px] shadow-2xl pointer-events-none"
          />
        </div>

        <!-- Slide 3 (Right initially) -->
        <div class="carousel-item absolute w-[240px] h-[300px] md:w-[456px] md:h-[570px] cursor-pointer origin-center" data-index="2">
          <img 
            src="/well.svg" 
            alt="Product Well" 
            class="w-full h-full object-cover rounded-[40px] shadow-lg pointer-events-none"
          />
        </div>

      </div>

      <!-- Right Navigation Button -->
      <button 
        id="next-btn" 
        class="absolute right-0 md:right-4 lg:-right-12 z-30 w-12 h-12 md:w-14 md:h-14 flex items-center justify-center bg-[#0066FF] hover:bg-blue-600 active:scale-95 text-white rounded-full transition-all duration-300 shadow-md cursor-pointer hover:shadow-lg focus:outline-none"
        aria-label="Next Product"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>

    </div>

    <!-- Dropdown / Year Selection -->
    <div class="flex items-center justify-center gap-4 w-[174px] h-[57px] text-black text-lg md:text-xl font-semibold rounded-[10px] border border-black cursor-pointer hover:bg-black/5 active:scale-95 transition-all mt-6">
      <span>2026</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>

  </div>
</section>

<style>
  /* 3D Carousel Item Styles */
  .carousel-item {
    transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.7s, z-index 0.7s;
    will-change: transform, opacity;
  }

  /* Center Slide */
  .slide-center {
    transform: translate3d(0, 0, 0) scale(1) rotateY(0deg);
    z-index: 30;
    opacity: 1;
  }

  /* Left Slide (Miring Masuk / 3D rotation inward) */
  .slide-left {
    transform: translate3d(-260px, 0, -80px) scale(0.8) rotateY(18deg);
    z-index: 20;
    opacity: 0.85;
  }

  /* Right Slide (Miring Masuk / 3D rotation inward) */
  .slide-right {
    transform: translate3d(260px, 0, -80px) scale(0.8) rotateY(-18deg);
    z-index: 20;
    opacity: 0.85;
  }

  /* Hidden Left */
  .slide-hidden-left {
    transform: translate3d(-450px, 0, -150px) scale(0.6) rotateY(30deg);
    z-index: 10;
    opacity: 0;
    pointer-events: none;
  }

  /* Hidden Right */
  .slide-hidden-right {
    transform: translate3d(450px, 0, -150px) scale(0.6) rotateY(-30deg);
    z-index: 10;
    opacity: 0;
    pointer-events: none;
  }

  /* Responsive styling for screen widths < 768px */
  @media (max-width: 768px) {
    .slide-left {
      transform: translate3d(-100px, 0, -50px) scale(0.7) rotateY(12deg);
      opacity: 0.7;
    }
    .slide-right {
      transform: translate3d(100px, 0, -50px) scale(0.7) rotateY(-12deg);
      opacity: 0.7;
    }
    .slide-center {
      transform: translate3d(0, 0, 0) scale(1) rotateY(0deg);
      z-index: 30;
      opacity: 1;
    }
  }
</style>

<script>
  function initCarousel() {
    const items = document.querySelectorAll('.carousel-item');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    if (items.length === 0) return;

    let currentIndex = 1; // Start with index 1 (will.svg in center)
    const totalItems = items.length;

    function updateCarousel() {
      items.forEach((item, index) => {
        // Clear classes
        item.classList.remove(
          'slide-center',
          'slide-left',
          'slide-right',
          'slide-hidden-left',
          'slide-hidden-right'
        );

        // Get shortest distance on modular cycle
        let diff = index - currentIndex;
        if (diff < -Math.floor(totalItems / 2)) diff += totalItems;
        if (diff > Math.floor(totalItems / 2)) diff -= totalItems;

        // Apply visual classes
        if (diff === 0) {
          item.classList.add('slide-center');
          (item as HTMLElement).style.pointerEvents = 'auto'; // allow interaction/clicks on center
        } else if (diff === 1) {
          item.classList.add('slide-right');
          (item as HTMLElement).style.pointerEvents = 'auto'; // allow clicking right item to navigate
        } else if (diff === -1) {
          item.classList.add('slide-left');
          (item as HTMLElement).style.pointerEvents = 'auto'; // allow clicking left item to navigate
        } else if (diff < 0) {
          item.classList.add('slide-hidden-left');
        } else {
          item.classList.add('slide-hidden-right');
        }
      });
    }

    // Handlers for next / prev
    function showNext() {
      currentIndex = (currentIndex + 1) % totalItems;
      updateCarousel();
    }

    // Handlers for prev
    function showPrev() {
      currentIndex = (currentIndex - 1 + totalItems) % totalItems;
      updateCarousel();
    }

    prevBtn?.addEventListener('click', showPrev);
    nextBtn?.addEventListener('click', showNext);

    // Direct click navigation on cards
    items.forEach((item, index) => {
      item.addEventListener('click', () => {
        if (index !== currentIndex) {
          currentIndex = index;
          updateCarousel();
        }
      });
    });

    // Touch / Swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    const track = document.querySelector('.carousel-track');

    if (track) {
      track.addEventListener('touchstart', (e: any) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      track.addEventListener('touchend', (e: any) => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });
    }

    function handleSwipe() {
      const threshold = 50; // min swipe distance in px
      if (touchStartX - touchEndX > threshold) {
        showNext(); // swiped left -> show next
      } else if (touchEndX - touchStartX > threshold) {
        showPrev(); // swiped right -> show prev
      }
    }

    // Set initial state
    updateCarousel();
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initCarousel);
  // Re-run for Astro View Transitions (if used)
  document.addEventListener('astro:page-load', initCarousel);
</script>