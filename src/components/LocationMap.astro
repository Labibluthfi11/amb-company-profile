<script>
  function initFaqAccordion() {
    const headers = document.querySelectorAll('.accordion-header');

    if (headers.length === 0) return;

    headers.forEach((header, index) => {
      header.addEventListener('click', () => {
        const item = header.parentElement;
        if (!item) return;

        const content = item.querySelector('.accordion-content') as HTMLElement;
        const svg = header.querySelector('svg');
        
        if (!content || !svg) return;

        const isCurrentlyExpanded = content.style.maxHeight && content.style.maxHeight !== '0px';

        // 1. Close all other accordions smoothly
        document.querySelectorAll('.accordion-item').forEach((otherItem) => {
          if (otherItem !== item) {
            const otherContent = otherItem.querySelector('.accordion-content') as HTMLElement;
            const otherSvg = otherItem.querySelector('svg');
            if (otherContent) {
              otherContent.style.maxHeight = '0px';
            }
            if (otherSvg) {
              otherSvg.classList.remove('rotate-180');
            }
          }
        });

        // 2. Toggle current accordion
        if (!isCurrentlyExpanded) {
          content.style.maxHeight = content.scrollHeight + 'px';
          svg.classList.add('rotate-180');
        } else {
          content.style.maxHeight = '0px';
          svg.classList.remove('rotate-180');
        }
      });
    });

    // Initialize first accordion item as OPEN by default
    const firstItem = document.querySelector('.accordion-item');
    if (firstItem) {
      const firstContent = firstItem.querySelector('.accordion-content') as HTMLElement;
      const firstSvg = firstItem.querySelector('svg');
      if (firstContent && firstSvg) {
        firstContent.style.maxHeight = firstContent.scrollHeight + 'px';
        firstSvg.classList.add('rotate-180');
      }
    }
  }

  // Run on load
  document.addEventListener('DOMContentLoaded', initFaqAccordion);
  // Re-run on Astro Page load
  document.addEventListener('astro:page-load', initFaqAccordion);
</script>