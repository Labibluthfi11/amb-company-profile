---
<section class="container mx-auto px-6 py-20 space-y-8">
  <h2 class="text-4xl font-sans font-bold text-text-dark text-center">Frequently Asked Question</h2>
  <div class="max-w-3xl mx-auto space-y-4">
    {Array.from({ length: 3 }).map((_, i) => (
      <details class="bg-bg-alt p-6 rounded-2xl">
        <summary class="font-bold cursor-pointer text-text-dark">Pertanyaan {i + 1}?</summary>
        <p class="text-text-muted mt-4">Jawaban untuk pertanyaan {i + 1}...</p>
      </details>
    ))}
  </div>
</section>
