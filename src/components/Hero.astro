    <div class="flex items-center gap-8 pt-4 animate-fade-in-up delay-300" id="button-container">
      <a href="/explore" class="hero-btn group bg-primary text-white px-8 py-3 rounded-full font-sans flex items-center gap-3 font-semibold transition-all duration-300 active-btn">
        Explore More
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/services" class="hero-btn group text-text-dark px-8 py-3 rounded-full font-sans flex items-center gap-2 font-semibold transition-all duration-300">
        View All Service
        <svg width="24" height="24" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform group-hover:translate-x-1">
