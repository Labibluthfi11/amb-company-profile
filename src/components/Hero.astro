    </div>

<script>
  const buttons = document.querySelectorAll('.hero-btn');
  
  buttons.forEach(button => {
    button.addEventListener('mouseenter', () => {
      buttons.forEach(b => b.classList.remove('active-btn', 'bg-primary', 'text-white'));
      buttons.forEach(b => b.classList.add('text-text-dark'));
      button.classList.add('active-btn', 'bg-primary', 'text-white');
      button.classList.remove('text-text-dark');
    });
  });
</script>

<style>
  .hero-btn {
    border: 2px solid transparent;
  }
  .active-btn {
    background-color: #2563eb; /* bg-blue-600 */
    color: white;
  }
  /* Ensure text color is managed correctly */
  .hero-btn:not(.active-btn) {
    color: #374151; /* text-text-dark */
  }
</style>
  </div>
  <div class="flex-1 animate-fade-in-up delay-400">
    <!-- Wrapper untuk menentukan posisi & jalannya animasi melayang (float) secara smooth -->
    <div class="w-full max-w-[560px] mx-auto md:ml-auto -translate-y-4 md:-translate-y-17 animate-float">
      <!-- Menggunakan foto asli /lab.png yang transparan tanpa background putih -->
      <!-- Menggunakan drop-shadow khusus PNG (filter drop-shadow) agar bayangan mengikuti lekukan botol & kaca -->
      <img 
        src="/lab.png" 
        alt="Hero" 
        class="w-full h-auto cursor-pointer select-none transition-all duration-300 hover:scale-105 active:scale-95 drop-shadow-[0_10px_20px_rgba(59,130,246,0.12)] hover:drop-shadow-[0_20px_35px_rgba(59,130,246,0.25)]" 
      />
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .delay-100 {
    animation-delay: 100ms;
  }
  .delay-200 {
    animation-delay: 200ms;
  }
  .delay-300 {
    animation-delay: 300ms;
  }
  .delay-400 {
    animation-delay: 400ms;
  }

  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
</style>
